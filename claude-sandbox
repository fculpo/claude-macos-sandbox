#!/usr/bin/env python3
"""claude-sandbox — macOS sandbox-exec wrapper for Claude Code.

Restricts filesystem and network access via an SBPL profile, and enforces
domain-level network filtering through a local HTTPS CONNECT proxy.

Architecture:
  [Claude Code in sandbox] --HTTPS_PROXY--> [localhost proxy] --> [Internet]
  SBPL restricts to localhost-only; proxy whitelists allowed domains.
"""

import argparse
import atexit
import glob
import json
import os
import signal
import subprocess
import sys
import tempfile
import time
from pathlib import Path

HOME = Path.home()

DEFAULT_CLAUDE_BIN = HOME / ".local" / "bin" / "claude"
DEFAULT_CONFIG_FILE = HOME / ".config" / "claude-sandbox" / "config"

DEFAULT_DOMAINS = [
    "api.anthropic.com",
    "mcp-proxy.anthropic.com",
    "statsig.anthropic.com",
    "platform.claude.com",
]


# ---------------------------------------------------------------------------
# Config file loading
# ---------------------------------------------------------------------------
def load_config(path: Path) -> tuple[list[str], list[str], list[str]]:
    """Load write dirs, read dirs, and domains from config file."""
    write_dirs, read_dirs, domains = [], [], []
    if not path.is_file():
        return write_dirs, read_dirs, domains

    for line in path.read_text().splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("write="):
            write_dirs.append(line[len("write="):])
        elif line.startswith("read="):
            read_dirs.append(line[len("read="):])
        elif line.startswith("domain="):
            domains.append(line[len("domain="):])
        else:
            print(f"config: ignoring unknown line: {line}", file=sys.stderr)

    return write_dirs, read_dirs, domains


def dedupe(items: list[str]) -> list[str]:
    """Deduplicate preserving order, filtering empty strings."""
    seen = set()
    result = []
    for item in items:
        if item and item not in seen:
            seen.add(item)
            result.append(item)
    return result


def validate_dirs(label: str, dirs: list[str]) -> list[str]:
    """Warn and skip directories that don't exist."""
    valid = []
    for d in dirs:
        if not d:
            continue
        if os.path.exists(d):
            valid.append(d)
        else:
            print(f"warning: {label} path does not exist, skipping: {d}",
                  file=sys.stderr)
    return valid


# ---------------------------------------------------------------------------
# SBPL profile generation
# ---------------------------------------------------------------------------
def generate_sbpl(
    read_dirs: list[str],
    write_dirs: list[str],
    sensitive_dirs: list[str] | None = None,
    allow_all_network: bool = False,
) -> str:
    """Generate the SBPL sandbox profile."""
    home = str(HOME)

    if sensitive_dirs is None:
        sensitive_dirs = [".ssh", ".aws", ".kube", ".docker"]

    # GPG dirs: allow reads (public keyring lookup) but deny writes.
    # Private key operations are handled by the pre-launched gpg-agent.
    gpg_dirs = [".gnupg", ".gpg"]

    lines = [
        '(version 1)',
        '(deny default)',
        '(trace "/tmp/claude-sandbox-violations.log")',
        '',
        ';; --- Process ---',
        '(allow process-exec)',
        '(allow process-fork)',
        '(allow process-info-pidinfo)',
        '(allow signal)',
        '',
        ';; --- Sysctl ---',
        '(allow sysctl-read)',
        '',
        ';; --- Mach IPC ---',
        '(allow mach-lookup)',
        '',
        ';; --- IPC / POSIX shared memory ---',
        '(allow ipc-posix-shm-read-data)',
        '(allow ipc-posix-shm-read-metadata)',
        '(allow ipc-posix-shm-write-create)',
        '(allow ipc-posix-shm-write-data)',
        '(allow ipc-posix-shm-write-unlink)',
        '',
        ';; --- File metadata and data (global) ---',
        '(allow file-read-metadata)',
        '(allow file-read-data)',
        '(allow file-ioctl)',
        '',
        ';; --- System read paths ---',
        '(allow file-read-data (literal "/"))',
        '(allow file-read* (subpath "/bin"))',
        '(allow file-read* (subpath "/sbin"))',
        '(allow file-read* (subpath "/usr/lib"))',
        '(allow file-read* (subpath "/usr/share"))',
        '(allow file-read* (subpath "/usr/bin"))',
        '(allow file-read* (subpath "/usr/sbin"))',
        '(allow file-read* (subpath "/usr/local"))',
        '(allow file-read* (subpath "/System"))',
        '(allow file-read* (subpath "/Library"))',
        '(allow file-read* (subpath "/opt/homebrew"))',
        '(allow file-read* (subpath "/private/etc"))',
        '(allow file-read* (subpath "/private/var"))',
        '(allow file-read* (subpath "/etc"))',
        '(allow file-read* (subpath "/var"))',
        '(allow file-read* (subpath "/dev"))',
        '(allow file-read* (subpath "/tmp"))',
        '(allow file-read* (subpath "/private/tmp"))',
        '',
        ';; --- Home directory: broad read ---',
        f'(allow file-read* (subpath "{home}"))',
    ]

    # User read-only paths
    if read_dirs:
        lines.append('')
        lines.append(';; --- User read-only paths ---')
        for d in read_dirs:
            kind = "subpath" if os.path.isdir(d) else "literal"
            lines.append(f'(allow file-read* ({kind} "{d}"))')

    # Home directory: broad write
    lines.append('')
    lines.append(';; --- Home directory: broad write ---')
    lines.append(f'(allow file-write* (subpath "{home}"))')

    # User writable paths (project dirs from config/CLI)
    if write_dirs:
        lines.append('')
        lines.append(';; --- User writable paths ---')
        for d in write_dirs:
            kind = "subpath" if os.path.isdir(d) else "literal"
            lines.append(f'(allow file-read* ({kind} "{d}"))')
            lines.append(f'(allow file-write* ({kind} "{d}"))')

    # Temp / device writes (macOS TMPDIR is in /private/var/folders/, not /tmp)
    tmpdir = os.environ.get("TMPDIR", "").rstrip("/")
    tmpdir_lines = []
    if tmpdir and tmpdir not in ("/tmp", "/private/tmp"):
        real_tmpdir = os.path.realpath(tmpdir)
        tmpdir_lines.append(f'(allow file-read* (subpath "{tmpdir}"))')
        tmpdir_lines.append(f'(allow file-write* (subpath "{tmpdir}"))')
        if real_tmpdir != tmpdir:
            tmpdir_lines.append(f'(allow file-read* (subpath "{real_tmpdir}"))')
            tmpdir_lines.append(f'(allow file-write* (subpath "{real_tmpdir}"))')

    lines.extend([
        '',
        ';; --- Temp / device writes ---',
        '(allow file-write* (subpath "/tmp"))',
        '(allow file-write* (subpath "/private/tmp"))',
        f'(allow file-write* (subpath "{os.path.realpath(tempfile.gettempdir())}"))',
        '(allow file-write* (subpath "/dev"))',
        *tmpdir_lines,
    ])

    # Network rules
    lines.extend([
        '',
        ';; --- Network: system plumbing ---',
        '(allow network-outbound (control-name "com.apple.netsrc"))',
        '(allow network-outbound (control-name "com.apple.network.statistics"))',
        '(allow system-socket',
        '  (require-all (socket-domain AF_SYSTEM) (socket-protocol 2))',
        '  (socket-domain AF_ROUTE))',
    ])

    if allow_all_network:
        lines.extend([
            '',
            ';; --- Network: all outbound allowed (--no-net-filter) ---',
            '(allow network-outbound)',
            '(allow network-inbound)',
            '(allow network-bind)',
        ])
    else:
        lines.extend([
            '',
            ';; --- Network: localhost only (proxy handles external connections) ---',
            '(allow network-outbound (remote ip "localhost:*"))',
            '(allow network-outbound (remote unix-socket))',
            '(allow network-inbound (local ip "localhost:*"))',
            '(allow network-bind (local ip "localhost:*"))',
        ])

    # Deny sensitive home subdirectories (MUST come last — SBPL is last-match-wins)
    # Use explicit operations (file-read-data, file-read-xattr) instead of
    # file-read* because SBPL wildcard denies don't override specific allows.
    if sensitive_dirs:
        lines.append('')
        lines.append(';; --- Deny sensitive home directories (last-match-wins) ---')
        for name in sensitive_dirs:
            d = f"{home}/{name}"
            lines.append(f'(deny file-read-data (subpath "{d}"))')
            lines.append(f'(deny file-read-xattr (subpath "{d}"))')
            lines.append(f'(deny file-write* (subpath "{d}"))')

    # GPG directories: deny writes only (reads needed for public keyring lookup)
    if gpg_dirs:
        lines.append('')
        lines.append(';; --- GPG directories: write-deny only (read for signing) ---')
        for name in gpg_dirs:
            d = f"{home}/{name}"
            lines.append(f'(deny file-write* (subpath "{d}"))')

    return "\n".join(lines) + "\n"


# ---------------------------------------------------------------------------
# Proxy management
# ---------------------------------------------------------------------------
PROXY_LOG = "/tmp/claude-sandbox-proxy.log"


def _pid_exists(pid):
    """Check if a process is alive."""
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True  # exists but we can't signal it


def _supervisor_loop(proxy_pid, port, proxy_script, domains_path, pid_path,
                     sandbox_pid):
    """Monitor proxy and restart it on crash. Runs as a daemon process."""
    proxy_log = open(PROXY_LOG, "a")

    while True:
        time.sleep(2)

        # Sandbox gone → kill proxy and exit
        if not _pid_exists(sandbox_pid):
            try:
                os.kill(proxy_pid, signal.SIGTERM)
            except (ProcessLookupError, PermissionError):
                pass
            break

        # Proxy gone → restart on the same port
        if not _pid_exists(proxy_pid):
            print(f"claude-sandbox-supervisor: proxy (PID {proxy_pid}) died, "
                  f"restarting on port {port}",
                  file=sys.stderr, flush=True)
            time.sleep(0.5)
            try:
                new_proc = subprocess.Popen(
                    [sys.executable, proxy_script, "--port", str(port),
                     domains_path],
                    stdin=subprocess.DEVNULL,
                    stdout=subprocess.DEVNULL,
                    stderr=proxy_log,
                    start_new_session=True,
                )
                proxy_pid = new_proc.pid
                with open(pid_path, "w") as f:
                    f.write(str(proxy_pid))
                print(f"claude-sandbox-supervisor: proxy restarted "
                      f"(PID {proxy_pid})",
                      file=sys.stderr, flush=True)
            except Exception as e:
                print(f"claude-sandbox-supervisor: restart failed: {e}",
                      file=sys.stderr, flush=True)

    # Cleanup temp files
    for p in (domains_path, pid_path):
        try:
            os.unlink(p)
        except OSError:
            pass

    os._exit(0)


def start_proxy(domains: list[str], proxy_script: Path) -> tuple[subprocess.Popen, int]:
    """Start the domain-filtering proxy, return (process, port)."""
    domains_fd, domains_path = tempfile.mkstemp(prefix="claude-sandbox-domains-")
    with os.fdopen(domains_fd, "w") as f:
        json.dump(domains, f)

    port_fd, port_path = tempfile.mkstemp(prefix="claude-sandbox-port-")
    os.close(port_fd)

    # Append mode: safe for parallel sandbox instances
    proxy_log = open(PROXY_LOG, "a")
    proc = subprocess.Popen(
        [sys.executable, str(proxy_script), domains_path],
        stdin=subprocess.DEVNULL,
        stdout=open(port_path, "w"),
        stderr=proxy_log,
        start_new_session=True,
    )

    # Wait for proxy to write its port (up to 5 seconds)
    for _ in range(50):
        if os.path.getsize(port_path) > 0:
            break
        time.sleep(0.1)
    else:
        proc.kill()
        raise RuntimeError("proxy failed to start within 5 seconds")

    with open(port_path) as f:
        port = int(f.read().strip())

    try:
        os.unlink(port_path)
    except OSError:
        pass

    # Write PID file for easy signal targeting (kill -HUP)
    pid_path = f"/tmp/claude-sandbox-proxy-{port}.pid"
    with open(pid_path, "w") as f:
        f.write(str(proc.pid))

    # Fork a supervisor daemon that restarts the proxy on crash.
    # Double-fork to avoid zombies: child exits immediately,
    # grandchild runs as a detached daemon.
    sandbox_pid = os.getpid()
    child = os.fork()
    if child == 0:
        if os.fork() == 0:
            os.setsid()
            _supervisor_loop(proc.pid, port, str(proxy_script),
                             domains_path, pid_path, sandbox_pid)
        os._exit(0)
    os.waitpid(child, 0)

    return proc, port


# ---------------------------------------------------------------------------
# Subcommands
# ---------------------------------------------------------------------------
def _get_proxy_domains_path(pid):
    """Get the domains JSON path for a proxy process via its command line."""
    try:
        result = subprocess.run(
            ["ps", "-o", "args=", "-p", str(pid)],
            capture_output=True, text=True,
        )
        if result.returncode != 0:
            return None
        # Command line: python3 .../claude-sandbox-proxy.py [--port N] <domains-path>
        # The domains file is always the last argument
        args = result.stdout.strip().split()
        if args:
            candidate = args[-1]
            if "claude-sandbox-domains-" in candidate:
                return candidate
    except Exception:
        pass
    return None


def reload_proxies():
    """Re-generate domains JSON from config, then SIGHUP all proxies."""
    pid_files = glob.glob("/tmp/claude-sandbox-proxy-*.pid")
    if not pid_files:
        print("claude-sandbox: no proxy PID files found", file=sys.stderr)
        return

    # Load current config and compute merged domains
    config_file = Path(os.environ.get("CONFIG_FILE") or DEFAULT_CONFIG_FILE)
    _, _, cfg_domains = load_config(config_file)
    domains = dedupe([*DEFAULT_DOMAINS, *cfg_domains])

    for pid_file in pid_files:
        try:
            pid = int(Path(pid_file).read_text().strip())
        except (ValueError, OSError) as e:
            print(f"claude-sandbox: skipping {pid_file}: {e}", file=sys.stderr)
            continue

        # Check process is alive
        if not _pid_exists(pid):
            print(f"claude-sandbox: proxy PID {pid} not running (stale {pid_file})",
                  file=sys.stderr)
            continue

        # Find and update the proxy's domains JSON file
        domains_path = _get_proxy_domains_path(pid)
        if domains_path:
            try:
                with open(domains_path, "w") as f:
                    json.dump(domains, f)
                print(f"claude-sandbox: updated {domains_path} ({len(domains)} domains)",
                      file=sys.stderr)
            except OSError as e:
                print(f"claude-sandbox: failed to update {domains_path}: {e}",
                      file=sys.stderr)
                continue
        else:
            print(f"claude-sandbox: could not find domains file for PID {pid}, "
                  "sending SIGHUP anyway", file=sys.stderr)

        try:
            os.kill(pid, signal.SIGHUP)
            print(f"claude-sandbox: sent SIGHUP to proxy PID {pid}",
                  file=sys.stderr)
        except PermissionError:
            print(f"claude-sandbox: no permission to signal PID {pid}",
                  file=sys.stderr)


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------
def main():
    # Handle subcommands before argparse (preserves backward compatibility)
    if len(sys.argv) > 1 and sys.argv[1] == "reload-proxies":
        reload_proxies()
        return

    parser = argparse.ArgumentParser(
        description="Wrap Claude Code in a macOS sandbox with domain filtering.",
        epilog="Everything after '--' is forwarded to the claude binary.",
    )
    parser.add_argument("--project-dir", default=None,
                        help="Project directory (default: cwd)")
    parser.add_argument("--write-dir", action="append", default=[],
                        help="Additional writable directory (repeatable)")
    parser.add_argument("--read-dir", action="append", default=[],
                        help="Additional read-only directory (repeatable)")
    parser.add_argument("--allow-domain", action="append", default=[],
                        help="Additional domain to allow HTTPS access (repeatable)")
    parser.add_argument("--no-net-filter", action="store_true",
                        help="Disable network filtering (allow all outbound, no proxy)")
    parser.add_argument("--dry-run", action="store_true",
                        help="Print the SBPL profile and exit")
    parser.add_argument("--claude-bin", default=None,
                        help=f"Path to claude binary (default: {DEFAULT_CLAUDE_BIN})")
    parser.add_argument("--config", default=None,
                        help=f"Config file path (default: {DEFAULT_CONFIG_FILE})")

    # Split on '--' to separate our args from claude args
    argv = sys.argv[1:]
    claude_args = []
    if "--" in argv:
        idx = argv.index("--")
        claude_args = argv[idx + 1:]
        argv = argv[:idx]

    args = parser.parse_args(argv)

    claude_bin = args.claude_bin or os.environ.get("CLAUDE_BIN") or str(DEFAULT_CLAUDE_BIN)
    config_file = Path(args.config or os.environ.get("CONFIG_FILE") or DEFAULT_CONFIG_FILE)

    project_dir = os.path.abspath(args.project_dir or os.getcwd())

    # Load config
    cfg_write, cfg_read, cfg_domains = load_config(config_file)

    # Merge and deduplicate
    write_dirs = dedupe([
        str(HOME / ".claude"),
        str(HOME / ".cache"),
        str(HOME / ".bun"),
        str(HOME / ".local" / "share" / "claude"),
        str(HOME / ".npm"),
        str(HOME / ".config"),
        *args.write_dir,
        *cfg_write,
    ])
    read_dirs = dedupe([*args.read_dir, *cfg_read])
    domains = dedupe([*DEFAULT_DOMAINS, *args.allow_domain, *cfg_domains])

    # Validate paths
    write_dirs = validate_dirs("write", write_dirs)
    read_dirs = validate_dirs("read", read_dirs)

    print(f"claude-sandbox: {len(domains)} allowed domains", file=sys.stderr)

    # Generate SBPL
    sbpl = generate_sbpl(read_dirs, write_dirs,
                         allow_all_network=args.no_net_filter)

    sbpl_fd, sbpl_path = tempfile.mkstemp(prefix="claude-sandbox-")
    with os.fdopen(sbpl_fd, "w") as f:
        f.write(sbpl)
    atexit.register(lambda: os.unlink(sbpl_path) if os.path.exists(sbpl_path) else None)

    if args.dry_run:
        print(sbpl, end="")
        return

    if args.no_net_filter:
        print("claude-sandbox: network filtering disabled (--no-net-filter)",
              file=sys.stderr)
    else:
        # Start proxy
        proxy_script = Path(__file__).resolve().parent / "claude-sandbox-proxy.py"
        _, proxy_port = start_proxy(domains, proxy_script)

        print(f"claude-sandbox: proxy on 127.0.0.1:{proxy_port}", file=sys.stderr)
        print(f"claude-sandbox: proxy PID file: /tmp/claude-sandbox-proxy-{proxy_port}.pid",
              file=sys.stderr)
        print(f"claude-sandbox: proxy log: {PROXY_LOG}", file=sys.stderr)
        print("claude-sandbox: reload domains: edit domains JSON then "
              f"kill -HUP $(cat /tmp/claude-sandbox-proxy-{proxy_port}.pid)",
              file=sys.stderr)

        os.environ["HTTPS_PROXY"] = f"http://127.0.0.1:{proxy_port}"
        os.environ["HTTP_PROXY"] = f"http://127.0.0.1:{proxy_port}"
        os.environ["NO_PROXY"] = "localhost,127.0.0.1"

    print("claude-sandbox: launching claude in sandbox", file=sys.stderr)

    # Prepend shims directory to PATH so the ps shim is found before /bin/ps.
    # /bin/ps is setuid and cannot run inside sandbox-exec; the shim handles
    # the TTY-detection patterns that ccstatusline uses for terminal width,
    # giving it dynamic resize support (unlike a static COLUMNS env var).
    shims_dir = str(Path(__file__).resolve().parent / "shims")
    os.environ["PATH"] = shims_dir + ":" + os.environ.get("PATH", "")

    # Pre-launch gpg-agent so GPG inside the sandbox can connect to it
    # without needing to start the agent itself.
    subprocess.run(["gpgconf", "--launch", "gpg-agent"],
                   capture_output=True)

    os.execvp("sandbox-exec", ["sandbox-exec", "-f", sbpl_path, claude_bin,
              "--dangerously-skip-permissions", *claude_args])


if __name__ == "__main__":
    main()
